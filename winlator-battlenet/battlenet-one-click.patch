diff --git a/app/src/main/java/com/winlator/battlenet/BattleNetOneClick.java b/app/src/main/java/com/winlator/battlenet/BattleNetOneClick.java
new file mode 100644
index 0000000..e549116
--- /dev/null
+++ b/app/src/main/java/com/winlator/battlenet/BattleNetOneClick.java
@@ -0,0 +1,185 @@
+package com.winlator.battlenet;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.widget.Toast;
+
+import com.winlator.R;
+import com.winlator.XServerDisplayActivity;
+import com.winlator.box64.Box64Preset;
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+import com.winlator.container.GraphicsDrivers;
+import com.winlator.contentdialog.ContentDialog;
+import com.winlator.core.EnvVars;
+import com.winlator.core.FileUtils;
+import com.winlator.core.GPUHelper;
+import com.winlator.core.HttpUtils;
+import com.winlator.core.PreloaderDialog;
+import com.winlator.core.WineRegistryEditor;
+import com.winlator.core.WineThemeManager;
+import com.winlator.widget.FrameRating;
+import com.winlator.xenvironment.RootFS;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+
+/**
+ * One-click flow for Battle.net:
+ *  1. Creates (once) a container preconfigured for Battle.net.
+ *  2. Downloads the official installer from Blizzard's servers (never bundled).
+ *  3. Runs the installer, or the installed launcher on later taps.
+ */
+public final class BattleNetOneClick {
+    public static final String EXTRA_TAG = "battlenetOneClick";
+    public static final String INTENT_EXTRA = "battlenet_one_click";
+    public static final String CONTAINER_NAME = "Battle.net";
+    public static final String INSTALLER_URL = "https://downloader.battle.net/download/getInstaller?os=win&installer=Battle.net-Setup.exe";
+    public static final String SCREEN_SIZE = "1280x720";
+
+    /** Workaround for the Battle.net login window not showing or crashing under Wine. */
+    private static final String EXTRA_ENV_VARS = "WINE_SIMULATE_WRITECOPY=1";
+
+    private static final String[] LAUNCHER_PATHS = {
+        "Program Files (x86)/Battle.net/Battle.net Launcher.exe",
+        "Program Files (x86)/Battle.net/Battle.net.exe",
+        "Program Files/Battle.net/Battle.net Launcher.exe",
+        "Program Files/Battle.net/Battle.net.exe"
+    };
+
+    private BattleNetOneClick() {}
+
+    public interface OnContainersChanged {
+        void call();
+    }
+
+    public static void start(final Activity activity, final ContainerManager manager, final OnContainersChanged onContainersChanged) {
+        if (!RootFS.find(activity).isValid()) {
+            Toast.makeText(activity, R.string.battlenet_wait_for_install, Toast.LENGTH_LONG).show();
+            return;
+        }
+
+        Container container = findContainer(manager);
+        if (container != null) {
+            continueWith(activity, container);
+            return;
+        }
+
+        ContentDialog.confirm(activity, R.string.battlenet_confirm_create, () -> {
+            final PreloaderDialog preloaderDialog = new PreloaderDialog(activity);
+            preloaderDialog.show(R.string.creating_container);
+            try {
+                manager.createContainerAsync(buildContainerData(activity), (created) -> {
+                    preloaderDialog.close();
+                    if (created == null) {
+                        ContentDialog.alert(activity, R.string.battlenet_create_failed, null);
+                        return;
+                    }
+                    created.putExtra(EXTRA_TAG, "1");
+                    created.saveData();
+                    applyRegistryDefaults(created);
+                    if (onContainersChanged != null) onContainersChanged.call();
+                    continueWith(activity, created);
+                });
+            }
+            catch (JSONException e) {
+                preloaderDialog.close();
+                ContentDialog.alert(activity, R.string.battlenet_create_failed, null);
+            }
+        });
+    }
+
+    public static Container findContainer(ContainerManager manager) {
+        for (Container container : manager.getContainers()) {
+            if (container.getExtra(EXTRA_TAG).equals("1")) return container;
+        }
+        return null;
+    }
+
+    public static File findLauncher(Container container) {
+        File driveC = getDriveC(container);
+        for (String path : LAUNCHER_PATHS) {
+            File file = new File(driveC, path);
+            if (file.isFile()) return file;
+        }
+        return null;
+    }
+
+    private static void continueWith(Activity activity, Container container) {
+        File launcher = findLauncher(container);
+        if (launcher != null) {
+            launch(activity, container, launcher);
+            return;
+        }
+
+        final File installer = getInstallerFile(container);
+        if (installer.isFile() && installer.length() > 0) {
+            launch(activity, container, installer);
+            return;
+        }
+
+        File parent = installer.getParentFile();
+        if (parent != null) parent.mkdirs();
+
+        HttpUtils.download(activity, INSTALLER_URL, installer, (success) -> {
+            if (success && installer.isFile() && installer.length() > 0) {
+                launch(activity, container, installer);
+            }
+            else ContentDialog.alert(activity, R.string.battlenet_download_failed, null);
+        });
+    }
+
+    private static void launch(Activity activity, Container container, File exe) {
+        FileUtils.chmod(exe, 0771);
+        Intent intent = new Intent(activity, XServerDisplayActivity.class);
+        intent.putExtra("container_id", container.id);
+        intent.putExtra("exec_path", exe.getPath());
+        intent.putExtra(INTENT_EXTRA, true);
+        activity.startActivity(intent);
+    }
+
+    private static File getDriveC(Container container) {
+        return new File(container.getRootDir(), ".wine/drive_c");
+    }
+
+    private static File getInstallerFile(Container container) {
+        return new File(getDriveC(container), "BattleNetSetup/Battle.net-Setup.exe");
+    }
+
+    private static JSONObject buildContainerData(Context context) throws JSONException {
+        EnvVars envVars = new EnvVars(Container.DEFAULT_ENV_VARS);
+        envVars.putAll(new EnvVars(EXTRA_ENV_VARS));
+
+        // Turnip only works on Adreno GPUs; keep the app default (Vortek) everywhere else.
+        String vulkanDriver = GPUHelper.getAdrenoModelId(context) > 0 ? GraphicsDrivers.TURNIP : GraphicsDrivers.DEFAULT_VULKAN_DRIVER;
+
+        JSONObject data = new JSONObject();
+        data.put("name", CONTAINER_NAME);
+        data.put("screenSize", SCREEN_SIZE);
+        data.put("envVars", envVars.toString());
+        data.put("graphicsDriver", vulkanDriver+","+GraphicsDrivers.DEFAULT_OPENGL_DRIVER);
+        data.put("dxwrapper", Container.DEFAULT_DXWRAPPER);
+        data.put("audioDriver", Container.DEFAULT_AUDIO_DRIVER);
+        data.put("wincomponents", Container.DEFAULT_WINCOMPONENTS);
+        data.put("drives", Container.DEFAULT_DRIVES);
+        data.put("hudMode", (byte)FrameRating.Mode.SIMPLE.ordinal());
+        data.put("startupSelection", Container.STARTUP_SELECTION_ESSENTIAL);
+        data.put("box64Preset", Box64Preset.STABILITY);
+        data.put("desktopTheme", WineThemeManager.DEFAULT_DESKTOP_THEME);
+        return data;
+    }
+
+    /** Same Direct3D/input registry defaults the regular "create container" screen writes. */
+    private static void applyRegistryDefaults(Container container) {
+        File userRegFile = new File(container.getRootDir(), ".wine/user.reg");
+        if (!userRegFile.isFile()) return;
+        try (WineRegistryEditor registryEditor = new WineRegistryEditor(userRegFile)) {
+            registryEditor.setStringValue("Software\\Wine\\DirectInput", "MouseWarpOverride", "enable");
+            registryEditor.setStringValue("Software\\Wine\\Direct3D", "shader_backend", "glsl");
+            registryEditor.setStringValue("Software\\Wine\\Direct3D", "UseGLSL", "enabled");
+        }
+    }
+}
